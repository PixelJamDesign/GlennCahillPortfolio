---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import HeroParticles from '../../components/HeroParticles.astro';

export async function getStaticPaths() {
  const projects = await getCollection('work');
  const sorted = [...projects].sort((a, b) => a.data.order - b.data.order);
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: sorted[(i - 1 + sorted.length) % sorted.length],
      next: sorted[(i + 1) % sorted.length],
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} | Glenn Cahill`} description={entry.data.excerpt}>
  <header class="cs-hero">
    <div class="aurora" aria-hidden="true">
      <div class="blob blob-1"></div>
      <div class="blob blob-3"></div>
    </div>
    <HeroParticles />
    <div class="wrap">
      <p class="cs-crumb reveal"><a href="/work">Work</a> <span>/</span> {entry.data.tag}</p>
      <h1 class="cs-title reveal">{entry.data.title}</h1>
      {entry.data.excerpt && <p class="cs-excerpt reveal">{entry.data.excerpt}</p>}
    </div>
  </header>

  <div class="wrap">
    <div class="cs-cover reveal">
      <img src={entry.data.cover} alt={entry.data.title} />
    </div>

    <article class="cs-body">
      <Content />
    </article>

    <nav class="cs-pager">
      <a href={`/work/${prev.id}`} class="cs-pager-link">
        <span>← Previous</span>
        <b>{prev.data.title}</b>
      </a>
      <a href={`/work/${next.id}`} class="cs-pager-link cs-pager-next">
        <span>Next →</span>
        <b>{next.data.title}</b>
      </a>
    </nav>

    <div class="cs-cta">
      <p>Like what you see?</p>
      <Button variant="primary" href="/#contact">Let's talk</Button>
    </div>
  </div>
</BaseLayout>
