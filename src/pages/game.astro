  music.volume = (settings.musicVol / 100) * MUSIC_TRIM;
  music.preload = 'auto';
  const syncMusic = () => {
    if (settings.music && mode !== 'title') music.play().catch(() => {});
    else music.pause();
  };

  let ac = null;
  let phoneBusy = false;
  const blip = (freq = 880, dur = 0.05, vol = 0.04) => {
    if (!settings.sfx) return;
    vol *= settings.sfxVol / 70; // 70 = the tuned default loudness
    if (vol <= 0) return;
    try {
      ac = ac || new (window.AudioContext || window.webkitAudioContext)();
      const o = ac.createOscillator(), g = ac.createGain();
      o.type = 'square'; o.frequency.value = freq;
      g.gain.setValueAtTime(vol, ac.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, ac.currentTime + dur);
      o.connect(g); g.connect(ac.destination);
      o.start(); o.stop(ac.currentTime + dur);
    } catch {}
  };
  const jingle = () => { [523, 659, 784, 1047].forEach((f, i) => setTimeout(() => blip(f, 0.09, 0.05), i * 90)); };
  // classic UK double ring, twice: bring-bring... bring-bring... then done
  const phoneRing = (done) => {
    const burst = (at) => setTimeout(() => { blip(420, 0.35, 0.045); blip(466, 0.35, 0.045); }, at);
    [0, 450, 1500, 1950].forEach(burst);
    setTimeout(done, 2700);
  };

  // ---------- dialog ----------
  // wrap by measured pixel width: Tengoku is proportional, so counting
  // characters left lines well short of the box edge
  const wrapText = (text, maxPx) => {
    ctx.font = `${FS}px ${PXFONT}`;
    const words = text.split(' ');
    const lines = []; let line = '';
    for (const w of words) {
      const candidate = (line + ' ' + w).trim();
      if (line && ctx.measureText(candidate).width > maxPx) { lines.push(line.trim()); line = w; }
      else line = candidate;
    }
    if (line.trim()) lines.push(line.trim());
    return lines;
  };
  // usable dialog text width: box spans 2..W-2, text starts x11, rail ends W-6
  const DIALOG_TEXT_W = W - 11 - 8;

  const openDialog = (title, body) => {
    // 26 chars max at 16/3 px per glyph inside the 148px dialog; titles wrap too
    const lines = title ? [...wrapText(title, DIALOG_TEXT_W), ...wrapText(body, DIALOG_TEXT_W)] : wrapText(body, DIALOG_TEXT_W);
    const pages = [];
    for (let i = 0; i < lines.length; i += 4) pages.push(lines.slice(i, i + 4));
    dialog = { pages, page: 0, chars: 0 };
    mode = 'dialog';
    blip(660);
  };

  const advanceDialog = () => {
    const pageText = dialog.pages[dialog.page].join('\n');
    if (dialog.chars < pageText.length) { dialog.chars = pageText.length; return; }
    if (dialog.page < dialog.pages.length - 1) { dialog.page++; dialog.chars = 0; blip(720); }
    else closeDialog(520);
  };

  // ---------- warping ----------
  let lastCityDoor = { x: 3, y: 3 };

  const warpTo = (warp, fromX, fromY) => {
    if (!warp) return;
    if (warp.note) { openDialog(null, warp.note); return; }
    if (warp.job !== undefined) {
      // no office interiors: the door tells you the job right here
      const j = JOBS[warp.job];
      jobsRead.add(warp.job);
      openDialog(`${j.years} ${j.company}`, j.blurb);
      return;
    }
    if (!warp.to && !warp.back) return;
    const target = warp.back ? { to: 'careercity', x: lastCityDoor.x, y: lastCityDoor.y } : warp;
    mapId = target.to;
    player.x = target.x; player.y = target.y;
    player.px = player.x * TILE; player.py = player.y * TILE;
    player.moving = false;
    blip(392, 0.08);

    if (warp.levelUp) {
      jingle();
      banner = { text: warp.levelUp, t: 80, intro2: warp.intro2 };
      mode = 'banner';
      return;
    }
    const def = mapDef();
    if (def.intro && !introSeen.has(mapId)) {
      introSeen.add(mapId);
      setTimeout(() => openDialog(`= ${def.label} =`, def.intro), 60);
    }
  };

  // ---------- input ----------
  const held = { up: false, down: false, left: false, right: false };
  const keymap = {
    ArrowUp: 'up', ArrowDown: 'down', ArrowLeft: 'left', ArrowRight: 'right',
    w: 'up', s: 'down', a: 'left', d: 'right', W: 'up', S: 'down', A: 'left', D: 'right',
  };

  const closeDialog = (freq) => {
    dialog = null; mode = 'play';
    if (freq) blip(freq);
    if (pendingDialog) {
      const p = pendingDialog;
      pendingDialog = null;
      openDialog(p.title, p.body);
    }
  };

  // ---------- interaction ----------
  const bumpTile = (tx, ty) => {
    const t = tileAt(tx, ty);
    const key = `${tx},${ty}`;
    const def = mapDef();
    if (t === 'D') {
      const warp = def.warps[key];
      if (warp) { lastCityDoor = { x: player.x, y: player.y }; warpTo(warp, player.x, player.y); }
      return true;
    }
    if (t === 'S' && def.signs[key]) { blip(660); openDialog(null, def.signs[key]); return true; }
    if (t === 'P') { jingle(); openDialog('= 2026 =', FINALE); return true; }
    // phone boxes: let it ring out before the disappointment lands
    if (def.phones && def.phones.includes(key)) {
      if (!phoneBusy) {
        phoneBusy = true;
        phoneRing(() => {
          phoneBusy = false; blip(520);
          if (mode === 'play') openDialog(null, 'They hung up!');
          else pendingDialog = { title: null, body: 'They hung up!' };
        });
      }
      return true;
    }
    // any stretch of water shares one gag
    if (t === 'w' && def.waterText) { blip(660); openDialog(null, def.waterText); return true; }
    // flavour text keyed by coordinates on other solid tiles (walls, props, machines)
    if (def.signs[key]) { blip(660); openDialog(null, def.signs[key]); return true; }
    return false;
  };

  const pressA = () => {
    if (mode === 'title') {
      mode = 'play'; blip(880);
      syncMusic(); // user gesture: music may start now
      const def = mapDef();
      introSeen.add(mapId);
      openDialog(`= ${def.label} =`, def.intro);
      return;
    }
    if (mode === 'dialog') { advanceDialog(); return; }
    if (mode !== 'play') return;
    const dx = player.dir === 'left' ? -1 : player.dir === 'right' ? 1 : 0;
    const dy = player.dir === 'up' ? -1 : player.dir === 'down' ? 1 : 0;
    bumpTile(player.x + dx, player.y + dy);
  };

  // ---------- pause menu (drawn on the canvas, GB-style) ----------
  const pause = { open: false, t: 0, sel: 0 };
  const PAUSE_ROWS = 4; // music, sfx, fullscreen, close

  const togglePause = () => {
    pause.open = !pause.open;
    if (pause.open) pause.sel = 0;
    blip(pause.open ? 720 : 520);
  };

  const pauseAdjust = (dir) => {
    if (pause.sel === 0) {
      settings.musicVol = Math.max(0, Math.min(100, settings.musicVol + dir * 10));
      settings.music = settings.musicVol > 0;
      music.volume = (settings.musicVol / 100) * MUSIC_TRIM;
      syncMusic();
    } else if (pause.sel === 1) {
      settings.sfxVol = Math.max(0, Math.min(100, settings.sfxVol + dir * 10));
      settings.sfx = settings.sfxVol > 0;
      blip(880);
    }
    saveSettings();
  };

  const pauseSelect = () => {
    if (pause.sel === 3) { togglePause(); return; }
    if (pause.sel === 2) { setFull(!isFull()); blip(880); return; }
    if (pause.sel === 0) { settings.music = !settings.music; syncMusic(); }
    else { settings.sfx = !settings.sfx; if (settings.sfx) blip(880); }
    saveSettings();
  };

  const pauseInput = (key) => {
    if (key === 'up') { pause.sel = (pause.sel + PAUSE_ROWS - 1) % PAUSE_ROWS; blip(640, 0.02, 0.03); }
    else if (key === 'down') { pause.sel = (pause.sel + 1) % PAUSE_ROWS; blip(640, 0.02, 0.03); }
    else if (key === 'left') pauseAdjust(-1);
    else if (key === 'right') pauseAdjust(1);
    else if (key === 'a') pauseSelect();
    else if (key === 'b') togglePause();
  };

  // ---------- fullscreen + shell buttons ----------
  const page = document.querySelector('.gq-page');
  const isFull = () => page.classList.contains('gq-full');
  const setFull = (on) => {
    page.classList.toggle('gq-full', on);
    document.documentElement.style.overflow = on ? 'hidden' : '';
    document.body.style.overflow = on ? 'hidden' : '';
    // best-effort real fullscreen so the browser chrome gets out of the way
    // (iPhone Safari has no Fullscreen API for pages)
    try {
      if (on && document.documentElement.requestFullscreen) {
        document.documentElement.requestFullscreen({ navigationUI: 'hide' }).catch(() => {});
      } else if (!on && document.fullscreenElement) {
        document.exitFullscreen().catch(() => {});
      }
    } catch {}
  };
  document.addEventListener('fullscreenchange', () => {
    if (!document.fullscreenElement && page.classList.contains('gq-full')) {
      page.classList.remove('gq-full');
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
    }
  });

  // the HUD icons live on the canvas: map clicks back to logical pixels
  canvas.addEventListener('click', (e) => {
    const r = canvas.getBoundingClientRect();
    const lx = ((e.clientX - r.left) / r.width) * W;
    const ly = ((e.clientY - r.top) / r.height) * H;
    if (ly > 12) return;
    const hit = (z) => lx >= z.x - 2 && lx <= z.x + z.w + 2 && ly >= z.y - 2 && ly <= z.y + z.h + 2;
    if (hit(HUD_GEAR)) togglePause();
    else if (hit(HUD_FULL)) { setFull(!isFull()); blip(880); }
  });

  addEventListener('keydown', (e) => {
    if (pause.open) {
      if (keymap[e.key]) { pauseInput(keymap[e.key]); e.preventDefault(); }
      else if (e.key === 'Enter' || e.key === ' ' || e.key === 'z') { pauseInput('a'); e.preventDefault(); }
      else if (e.key === 'x') pauseInput('b');
      else if (e.key === 'Escape') togglePause();
      return;
    }
    if (keymap[e.key]) { held[keymap[e.key]] = true; e.preventDefault(); }
    if (e.key === 'Enter' || e.key === ' ' || e.key === 'z') { pressA(); e.preventDefault(); }
    if (e.key === 'Escape' && mode === 'dialog') closeDialog();
    if (e.key === 'Escape' && page.classList.contains('gq-full') && mode !== 'dialog') setFull(false);
  });
  addEventListener('keyup', (e) => { if (keymap[e.key]) held[keymap[e.key]] = false; });

  document.querySelectorAll('.gameboy [data-dir]').forEach((b) => {
    const dir = b.dataset.dir;
    let repeatTimer = null;
    b.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      if (pause.open) {
        pauseInput(dir);
        repeatTimer = setInterval(() => {
          if (pause.open) pauseInput(dir);
          else { clearInterval(repeatTimer); repeatTimer = null; }
        }, 160);
        return;
      }
      held[dir] = true;
    });
    const stopRepeat = () => {
      held[dir] = false;
      if (repeatTimer) { clearInterval(repeatTimer); repeatTimer = null; }
    };
    b.addEventListener('pointerup', stopRepeat);
    b.addEventListener('pointerleave', stopRepeat);
  });
  document.getElementById('gbA').addEventListener('pointerdown', (e) => {
    e.preventDefault();
    if (pause.open) { pauseInput('a'); return; }
    pressA();
  });
  document.getElementById('gbB').addEventListener('pointerdown', (e) => {
    e.preventDefault();
    if (pause.open) { pauseInput('b'); return; }
    if (mode === 'dialog') closeDialog(440);
  });
  document.getElementById('gbStart').addEventListener('click', () => togglePause());
  document.getElementById('gbSelect').addEventListener('click', () => { setFull(!isFull()); blip(880); });

  // ---------- movement ----------
  const SPEED = 0.8;
  const tryMove = () => {
    if (player.moving || mode !== 'play') return;
    let dx = 0, dy = 0;
    if (held.up) { dy = -1; player.dir = 'up'; }
    else if (held.down) { dy = 1; player.dir = 'down'; }
    else if (held.left) { dx = -1; player.dir = 'left'; }
    else if (held.right) { dx = 1; player.dir = 'right'; }
    if (!dx && !dy) return;
    const nx = player.x + dx, ny = player.y + dy;
    if (nx < 0 || ny < 0 || nx >= mapW() || ny >= mapH()) return;
    const t = tileAt(nx, ny);
    if (SOLID_CHARS.has(t)) { bumpTile(nx, ny); return; }
    player.x = nx; player.y = ny;
    player.moving = true;
  };

  const stepOnTile = () => {
    const t = tileAt(player.x, player.y);
    const key = `${player.x},${player.y}`;
    if (WALK_TRIGGER.has(t)) {
      const warp = mapDef().warps[key];
      if (warp) { warpTo(warp, player.x, player.y); return; }
    }
    const def = mapDef();
    if (t === 'i' && def.items[key] && !toysGot.has(`${mapId}:${key}`)) {
      toysGot.add(`${mapId}:${key}`);
      blip(1568, 0.08, 0.05);
      const item = def.items[key];
      if (typeof item === 'object') {
        if (item.img && COLLECT_IMG[item.img] && BAG_SHEET) {
          // backpack cutscene: gameplay pauses while the bag does its thing
          const [ix, iy] = key.split(',').map(Number);
          bagScene = { phase: 'in', t: 0, item, sx: ix * TILE + 8, sy: iy * TILE + 8 };
          mode = 'bag';
        } else {
          openDialog(`GOT ${item.name}!`, item.text);
        }
      } else {
        toast = { text: `GOT ${item}!`, t: 70 };
      }
    }
  };

  const updatePlayer = () => {
    if (mode === 'banner') {
      banner.t--;
      if (banner.t <= 0) {
        const intro2 = banner.intro2;
        banner = null; mode = 'play';
        if (intro2) openDialog(null, intro2);
      }
      return;
    }
    const tx2 = player.x * TILE, ty2 = player.y * TILE;
    if (player.px !== tx2 || player.py !== ty2) {
      player.px += Math.sign(tx2 - player.px) * Math.min(SPEED, Math.abs(tx2 - player.px));
      player.py += Math.sign(ty2 - player.py) * Math.min(SPEED, Math.abs(ty2 - player.py));
      if (player.px === tx2 && player.py === ty2) { player.moving = false; stepOnTile(); }
    } else {
      player.moving = false;
    }
  };

  // ---------- procedural tile fallback (only when no painted map/tile art) ----------
  const drawTile = (ch, px, py, interior) => {
    ctx.fillStyle = interior ? '#cfd4e8' : PAL[2];
    ctx.fillRect(px, py, TILE, TILE);
    if (ch === '.' ) {
      ctx.fillStyle = PAL[3]; ctx.fillRect(px + 1, py + 1, TILE - 2, TILE - 2);
    } else if (ch === '=' || ch === 'M' || ch === 'G' || ch === 'g') {
      ctx.fillStyle = '#c78c59'; ctx.fillRect(px, py, TILE, TILE);
      ctx.fillStyle = '#a9744a'; ctx.fillRect(px + 2, py + 2, 2, 2); ctx.fillRect(px + 9, py + 8, 2, 2);
    } else if (ch === 'w') {
      ctx.fillStyle = '#3f72ff'; ctx.fillRect(px, py, TILE, TILE);
      ctx.fillStyle = '#7fb2ff'; ctx.fillRect(px + 2, py + 4, 5, 1); ctx.fillRect(px + 8, py + 10, 5, 1);
    } else if (ch === 'T' || ch === 'f') {
      ctx.fillStyle = PAL[1]; ctx.fillRect(px + 1, py + 1, TILE - 2, TILE - 2);
      ctx.fillStyle = PAL[0]; ctx.fillRect(px + 4, py + 4, 3, 3); ctx.fillRect(px + 9, py + 8, 3, 3);
    } else if (ch === 'r' || ch === 'R') {
      ctx.fillStyle = PAL[1]; ctx.fillRect(px, py, TILE, TILE);
      ctx.fillStyle = PAL[0];
      for (let i = 0; i < 4; i++) ctx.fillRect(px, py + 2 + i * 4, TILE, 1);
    } else if (ch === 'H' || ch === 'b') {
      ctx.fillStyle = PAL[2]; ctx.fillRect(px, py, TILE, TILE);
      ctx.fillStyle = PAL[0];
      ctx.fillRect(px + 2, py + 3, 5, 5); ctx.fillRect(px + 9, py + 3, 5, 5);
      ctx.fillStyle = PAL[3];
      ctx.fillRect(px + 3, py + 4, 3, 3); ctx.fillRect(px + 10, py + 4, 3, 3);
      if (ch === 'b') { ctx.fillStyle = PAL[0]; ctx.fillRect(px + 2, py + 11, 12, 2); }
    } else if (ch === 'D') {
      ctx.fillStyle = PAL[2]; ctx.fillRect(px, py, TILE, TILE);
      ctx.fillStyle = PAL[0]; ctx.fillRect(px + 3, py + 2, 10, 14);
      ctx.fillStyle = PAL[1]; ctx.fillRect(px + 4, py + 3, 8, 12);
      ctx.fillStyle = PAL[3]; ctx.fillRect(px + 10, py + 9, 1, 2);
    } else if (ch === 'S') {
      ctx.fillStyle = PAL[0];
      ctx.fillRect(px + 2, py + 2, 12, 8); ctx.fillRect(px + 7, py + 10, 2, 5);
      ctx.fillStyle = PAL[3]; ctx.fillRect(px + 4, py + 4, 8, 1); ctx.fillRect(px + 4, py + 6, 6, 1);
    } else if (ch === '#') {
      ctx.fillStyle = PAL[0]; ctx.fillRect(px, py, TILE, TILE);
      ctx.fillStyle = PAL[1]; ctx.fillRect(px + 1, py + 1, TILE - 2, 5);
    } else if (ch === 'k') {
      ctx.fillStyle = PAL[0]; ctx.fillRect(px + 1, py + 4, 14, 11);
      ctx.fillStyle = PAL[2]; ctx.fillRect(px + 3, py + 6, 10, 5);
      ctx.fillStyle = PAL[1]; ctx.fillRect(px + 3, py + 11, 10, 2);
    } else if (ch === 'P') {
      ctx.fillStyle = PAL[0];
      ctx.fillRect(px + 4, py + 2, 8, 6); ctx.fillRect(px + 6, py + 8, 4, 3); ctx.fillRect(px + 3, py + 11, 10, 3);
      ctx.fillStyle = PAL[2]; ctx.fillRect(px + 6, py + 3, 2, 3);
      if (Math.floor(tick / 20) % 2) { ctx.fillStyle = PAL[3]; ctx.fillRect(px + 13, py + 1, 2, 2); }
    } else if (ch === 'i') {
      ctx.fillStyle = PAL[2];
      ctx.fillRect(px + 3, py + 4, 1, 1);
    }
  };

  // ---------- UI text + chrome ----------
  const text = (str, x, y, col = 0) => {
    ctx.fillStyle = UI[col];
    ctx.font = `${FS}px ${PXFONT}`;
    ctx.textBaseline = 'top';
    ctx.fillText(str, x, y);
  };

  // ---------- pixel metal rail (frames dialog + pause boxes) ----------
  const RAIL = { out: '#262430', hi: '#ececf5', light: '#c6c6d4', mid: '#9a9aaa', dark: '#6c6c7c' };
  const drawRail = (x, y, w, h) => {
    const ring = (n, col) => {
      ctx.fillStyle = col;
      ctx.fillRect(x + n, y + n, w - 2 * n, 1);
      ctx.fillRect(x + n, y + h - 1 - n, w - 2 * n, 1);
      ctx.fillRect(x + n, y + n, 1, h - 2 * n);
      ctx.fillRect(x + w - 1 - n, y + n, 1, h - 2 * n);
    };
    ring(0, RAIL.out);
    ring(1, RAIL.hi);
    ring(2, RAIL.mid);
    ring(3, RAIL.out);
    ctx.fillStyle = RAIL.dark;
    ctx.fillRect(x + 1, y + h - 2, w - 2, 1);
    ctx.fillRect(x + w - 2, y + 1, 1, h - 2);
    ctx.fillStyle = RAIL.hi;
    [[x + 1, y + 1], [x + w - 3, y + 1], [x + 1, y + h - 3], [x + w - 3, y + h - 3]]
      .forEach(([rx, ry]) => ctx.fillRect(rx, ry, 2, 2));
    ctx.fillStyle = RAIL.out;
    [[x + 2, y + 2], [x + w - 2, y + 2], [x + 2, y + h - 2], [x + w - 2, y + h - 2]]
      .forEach(([rx, ry]) => ctx.fillRect(rx, ry, 1, 1));
  };

  // ---------- HUD pixel icons ----------
  const drawIcon = (rows2, x, y, col) => {
    ctx.fillStyle = col;
    rows2.forEach((row, ry) => {
      for (let rx = 0; rx < row.length; rx++) {
        if (row[rx] === '1') ctx.fillRect(x + rx, y + ry, 1, 1);
      }
    });
  };
  const ICON_GEAR = [
    '00011000', '00111100', '01100110', '11000011',
    '11000011', '01100110', '00111100', '00011000',
  ];
  const ICON_FULL = [
    '11100111', '10000001', '10000001', '00000000',
    '00000000', '10000001', '10000001', '11100111',
  ];
  const ICON_BACKPACK = [
    '00111100', '01000010', '11111111', '10111101',
    '10100101', '10111101', '10100101', '11111111',
  ];
  const ICON_EXIT = [
    '00000000', '01000010', '00100100', '00011000',
    '00011000', '00100100', '01000010', '00000000',
  ];
  const HUD_GEAR = { x: 0, y: 1, w: 8, h: 8 };
  const HUD_FULL = { x: 0, y: 1, w: 8, h: 8 };
  const drawHudIcons = (col) => {
    HUD_FULL.x = W - 11;
    HUD_GEAR.x = W - 22;
    drawIcon(ICON_GEAR, HUD_GEAR.x, HUD_GEAR.y, col);
    drawIcon(isFull() ? ICON_EXIT : ICON_FULL, HUD_FULL.x, HUD_FULL.y, col);
  };

  const drawIconAt = (label, px, py) => {
    const rows8 = ICONS[label];
    if (!rows8) return;
    for (let y = 0; y < 8; y++) {
      const row = rows8[y];
      for (let x = 0; x < 8; x++) {
        const ch = row && row[x];
        if (!ch || ch === '.') continue;
        const col = CHAR_COL[ch];
        if (col === undefined) continue;
        ctx.fillStyle = PAL[col];
        ctx.fillRect(Math.round(px) + x, Math.round(py) + y, 1, 1);
      }
    }
  };

  // ---------- render ----------
  const render = () => {
    if (mode === 'title') {
      // bitmap title screen (Figma design); the two frames blink PRESS A
      const img = TITLE_IMG[Math.floor(tick / 30) % 2];
      if (img) {
        ctx.save();
        ctx.imageSmoothingEnabled = false;
        ctx.drawImage(img, 0, 0, W, H);
        ctx.restore();
      } else {
        ctx.fillStyle = '#151030';
        ctx.fillRect(0, 0, W, H);
      }
      // glinting stars over the night sky, steering clear of the logo
      for (let i = 0; i < 26; i++) {
        const h2 = (i * 2654435761) >>> 0;
        const sx = h2 % W;
        const sy = 2 + ((h2 >>> 9) % 36);
        if (sx > 26 && sx < 116 && sy > 3 && sy < 34) continue;
        const ph = Math.floor(tick / 12 + i * 3) % 8;
        if (ph > 3) continue; // dark most of the cycle: a glint, not a lamp
        ctx.fillStyle = ['#ffffff', '#b9b2e8', '#7fe9ff', '#b9b2e8'][i % 4];
        ctx.globalAlpha = ph === 1 || ph === 2 ? 1 : 0.45;
        ctx.fillRect(sx, sy, 1, 1);
        if (ph === 2) {
          ctx.globalAlpha = 0.7;
          ctx.fillRect(sx - 1, sy, 1, 1); ctx.fillRect(sx + 1, sy, 1, 1);
          ctx.fillRect(sx, sy - 1, 1, 1); ctx.fillRect(sx, sy + 1, 1, 1);
        }
        ctx.globalAlpha = 1;
      }
      drawHudIcons('#b9b2e8');
      return;
    }

    const interior = rows()[0][0] === '#';
    const MW = mapW() * TILE, MH = mapH() * TILE;
    const VH = H - HUD_H; // world viewport: the strip below the HUD bar
    let camX = Math.round(player.px - W / 2 + 8);
    let camY = Math.round(player.py - VH / 2 + 8);
    camX = Math.max(0, Math.min(camX, Math.max(0, MW - W)));
    camY = Math.max(0, Math.min(camY, Math.max(0, MH - VH)));
    if (MW < W) camX = -(W - MW) / 2;
    if (MH < VH) camY = -(VH - MH) / 2;

    ctx.fillStyle = PAL[0]; ctx.fillRect(0, 0, W, H);
    ctx.save();
    ctx.translate(0, HUD_H); // world space sits below the HUD from here on

    const x0 = Math.max(0, Math.floor(camX / TILE));
    const y0 = Math.max(0, Math.floor(camY / TILE));

    if (MAP_IMG[mapId]) {
      const img = MAP_IMG[mapId];
      const sc = mapDef().artScale || 3;
      ctx.save();
      ctx.imageSmoothingEnabled = false;
      ctx.drawImage(img, 0, 0, img.width, img.height, -camX, -camY, img.width / sc, img.height / sc);
      ctx.restore();
    } else {
      const theme = interior ? (mapDef().theme || 'home') : 'outdoor';
      const artOverride = mapDef().art;
      for (let y = y0; y <= y0 + Math.ceil(H / TILE) + 1 && y < mapH(); y++) {
        for (let x = x0; x <= x0 + Math.ceil(W / TILE) + 1 && x < mapW(); x++) {
          const ch = tileAt(x, y);
          const px = x * TILE - camX, py = y * TILE - camY;
          if (!drawTileArt(ch, px, py, theme, artOverride)) drawTile(ch, px, py, interior);
        }
      }
    }

    // items
    const def = mapDef();
    for (const key of Object.keys(def.items)) {
      if (toysGot.has(`${mapId}:${key}`)) continue;
      const [ix, iy] = key.split(',').map(Number);
      const item = def.items[key];
      if (typeof item === 'object' && item.img && COLLECT_IMG[item.img]) {
        // sprite collectable: slow floating bob, offset per item so they drift out of phase
        const img = COLLECT_IMG[item.img];
        const iw = img.width / 3, ih = img.height / 3;
        const bobF = Math.sin(tick / 24 + ix * 1.7) * 1.2;
        ctx.save();
        ctx.imageSmoothingEnabled = false;
        ctx.drawImage(img, ix * TILE + (TILE - iw) / 2 - camX, iy * TILE + (TILE - ih) / 2 - camY + bobF, iw, ih);
        ctx.restore();
      } else if (typeof item !== 'object') {
        const bob = Math.floor(tick / 15) % 2;
        drawIconAt(item, ix * TILE - camX + 4, iy * TILE - camY + 4 + bob);
      }
    }

    // scenery props + player, y-sorted by baseline so the player can walk
    // both in front of and behind free-standing objects
    const deferred = [];
    for (const p of def.props || []) {
      const img = PROP_IMG[p.img];
      if (!img) continue;
      const meta = PROP_META[p.img];
      const pw2 = img.width / 3, ph2 = img.height / 3;
      const px2 = (p.cx - meta.ccx) / 3, py2 = (p.bottom - meta.cb) / 3;
      deferred.push({
        base: p.bottom / 3,
        draw: () => {
          ctx.save();
          ctx.imageSmoothingEnabled = false;
          ctx.drawImage(img, px2 - camX, py2 - camY, pw2, ph2);
          ctx.restore();
        },
      });
    }

    // player — hi-res sheet if provided, procedural fallback otherwise.
    // baseline = feet position, so props sort naturally around him
    const age = def.age;
    const frame = player.moving ? Math.floor(tick / 8) % 2 : 0;
    const facing = player.dir === 'left' || player.dir === 'right' ? 'side' : player.dir;
    const flip = player.dir === 'left';
    const dx = player.px - camX, dy = player.py - camY - 2;
    deferred.push({ base: player.py / 1 + 16, draw: drawPlayer });
    deferred.sort((a, b) => a.base - b.base);
    for (const d of deferred) d.draw();

    function drawPlayer() {
    if (SHEETS[age]) {
      const cfg = SHEET_CONFIG[age];
      let srcX, srcY, doFlip = flip;
      if (cfg) {
        const anim = (player.moving ? cfg.walk : cfg.idle)[facing];
        const step = player.moving
          ? Math.floor(tick / 5) % cfg.frames
          : Math.floor(tick / 16) % cfg.frames;
        srcX = (anim.c + step) * cfg.fw; srcY = anim.r * cfg.fh;
        if (facing === 'side') doFlip = cfg.sideFaces === 'right' ? player.dir === 'left' : player.dir === 'right';
      } else {
        srcX = FRAME_INDEX[facing][frame] * 48; srcY = 0;
      }
      // hero renders at 2 tiles (32 logical px = clean 2x of the 48px frame)
      // 32px frame, drawn 6px higher than the strict tile: the painted roads
      // sit high in their rows, so this centres the body on the road band
      const sx = dx - 8, sy = Math.round(player.py) - camY - 20;
      ctx.save();
      ctx.imageSmoothingEnabled = false;
      if (doFlip) {
        ctx.translate(sx + 32, sy);
        ctx.scale(-1, 1);
        ctx.drawImage(SHEETS[age], srcX, srcY, 48, 48, 0, 0, 32, 32);
      } else {
        ctx.drawImage(SHEETS[age], srcX, srcY, 48, 48, sx, sy, 32, 32);
      }
      ctx.restore();
    } else {
      const set = SPRITES[age] || SPRITES[4];
      const sprRows = set[facing][frame];
      drawGrid(sprRows, dx, dy, flip, 16);
    }
    }

    ctx.restore(); // back to screen space for the HUD and overlays

    // HUD
    ctx.fillStyle = UI[3]; ctx.fillRect(0, 0, W, 10);
    ctx.fillStyle = UI[0]; ctx.fillRect(0, 10, W, 1);
    text(def.label, 3, 2);
    // right side of the bar, laid out right-to-left with measured gaps:
    // [J counter] [backpack + count] [gear] [fullscreen]
    ctx.font = `${FS}px ${PXFONT}`;
    const cnt = `${collectGot()}/${COLLECT_TOTAL}`;
    const cntW = ctx.measureText(cnt).width;
    const cntX = W - 26 - cntW;
    text(cnt, cntX, 2);
    const bpX = cntX - 10, bpY = backpackPulse > 6 ? 0 : 1;
    drawIcon(ICON_BACKPACK, bpX, bpY, UI[0]);
    const hudRight = `J${jobsRead.size}/12`;
    text(hudRight, bpX - ctx.measureText(hudRight).width - 5, 2);
    drawHudIcons(UI[0]);

    // backpack cutscene: slide in bottom-right, unzip, swallow the item, leave
    if (bagScene) {
      const s = bagScene;
      const frame = s.phase === 'unzip' ? Math.min(2, 1 + Math.floor(s.t / 8))
        : s.phase === 'zip' ? Math.max(0, 1 - Math.floor(s.t / 8))
        : s.phase === 'fly' ? 2 : 0;
      const img = BAG_SHEET;
      if (img) {
        const fw = img.width / 3, fh = img.height;
        // big and proud, per the design mock: ~2/3 screen height, tucked into
        // the corner with its right and bottom edges bleeding off screen
        const bh = 64;
        const bw = Math.round(fw * (bh / fh));
        const restX = W - bw + 8, restY = H - bh + 10;
        let bx = restX, by = restY;
        if (s.phase === 'in') {
          const e = 1 - Math.pow(1 - s.t / 14, 3);
          bx = restX + (1 - e) * bw;
          by = restY + (1 - e) * bh;
        } else if (s.phase === 'out') {
          const e = Math.pow(s.t / 14, 3);
          bx = restX + e * bw;
          by = restY + e * bh;
        }
        ctx.save();
        ctx.imageSmoothingEnabled = false; // pixel art: keep it crunchy
        ctx.drawImage(img, frame * fw, 0, fw, fh, bx, by, bw, bh);
        if (s.phase === 'fly') {
          const it = COLLECT_IMG[s.item.img];
          if (it) {
            const t2 = s.t / FLY_T;
            const e2 = t2 * t2;
            const sx2 = s.sx - camX, sy2 = s.sy - camY + HUD_H;
            // aim for the middle of the open mouth, not the top rim,
            // so the item visibly sinks INTO the bag
            const txp = bx + bw * 0.45, typ = by + bh * 0.34;
            const x = sx2 + (txp - sx2) * e2;
            const y = sy2 + (typ - sy2) * e2 - Math.sin(Math.PI * t2) * 16;
            // balloon up mid-flight so the item is clearly readable, then
            // shrink back down as it drops into the bag
            const sc = (1 - 0.6 * e2) / 3 + Math.sin(Math.PI * t2) * 0.5;
            ctx.imageSmoothingEnabled = false;
            // fade out over the last stretch: swallowed, not hidden behind
            if (t2 > 0.8) ctx.globalAlpha = Math.max(0, (1 - t2) / 0.2);
            ctx.drawImage(it, x - (it.width * sc) / 2, y - (it.height * sc) / 2, it.width * sc, it.height * sc);
            ctx.globalAlpha = 1;
          }
        }
        ctx.restore();
      }
    }

    // toast
    if (toast) {
      toast.t--;
      if (toast.t > 0) {
        ctx.font = `${FS}px ${PXFONT}`;
        const tw = ctx.measureText(toast.text).width;
        const tx2 = Math.max(2, Math.round((W - tw) / 2));
        ctx.fillStyle = UI[0]; ctx.fillRect(tx2 - 4, 13, tw + 8, 11);
        ctx.fillStyle = UI[3];
        ctx.fillText(toast.text, tx2, 16);
      } else toast = null;
    }

    // banner
    if (mode === 'banner' && banner) {
      const BY = Math.round(H / 2) - 20;
      ctx.fillStyle = UI[0]; ctx.fillRect(0, BY, W, 40);
      ctx.fillStyle = UI[3];
      ctx.font = `18px ${PXFONT}`;
      ctx.fillText('LEVEL UP!', Math.round((W - ctx.measureText('LEVEL UP!').width) / 2), BY + 4);
      ctx.font = `${FS}px ${PXFONT}`;
      ctx.fillText(banner.text, Math.round((W - ctx.measureText(banner.text).width) / 2), BY + 28);
    }

    // dialog
    if (mode === 'dialog' && dialog) {
      const DY = H - 50; // dialog box: bottom 48px + 2px margin
      ctx.fillStyle = UI[3]; ctx.fillRect(2, DY, W - 4, 48);
      drawRail(2, DY, W - 4, 48);
      const pageText = dialog.pages[dialog.page].join('\n');
      // type on the game clock, not per frame (frame rate varies by display):
      // one character every 3 ticks = 20 chars/sec, proper Game Boy pace
      if (dialog.chars < pageText.length && tick !== dialog.lastTypeTick && tick % 3 === 0) {
        dialog.chars += 1;
        if (dialog.chars % 3 === 0) blip(980, 0.015, 0.02);
      }
      dialog.lastTypeTick = tick;
      const shown = pageText.slice(0, dialog.chars).split('\n');
      shown.forEach((ln, i) => text(ln, 11, DY + 7 + i * 9));
      if (dialog.chars >= pageText.length && Math.floor(tick / 20) % 2) {
        ctx.fillStyle = UI[0];
        ctx.fillRect(W - 16, DY + 37, 7, 2);
        ctx.fillRect(W - 15, DY + 39, 5, 2);
        ctx.fillRect(W - 14, DY + 41, 3, 2);
      }
    }

    // pause menu on top of everything: dim, then slide the panel in from above
    if (pause.t > 0.01) {
      const ease = 1 - Math.pow(1 - pause.t, 3);
      ctx.fillStyle = `rgba(16, 10, 40, ${0.6 * ease})`;
      ctx.fillRect(0, 0, W, H);
      const pw = 110, ph = 75;
      const px0 = Math.round((W - pw) / 2);
      const targetY = Math.round((H - ph) / 2);
      const py0 = Math.round(targetY * ease - ph * (1 - ease));
      ctx.fillStyle = UI[3]; ctx.fillRect(px0, py0, pw, ph);
      drawRail(px0, py0, pw, ph);
      ctx.font = `${FS}px ${PXFONT}`;
      ctx.textBaseline = 'top';
      ctx.fillText('= PAUSED =', px0 + Math.round((pw - ctx.measureText('= PAUSED =').width) / 2), py0 + 5);
      const menuRows = [
        { label: 'MUSIC', vol: settings.musicVol, on: settings.music },
        { label: 'SFX', vol: settings.sfxVol, on: settings.sfx },
      ];
      menuRows.forEach((row, i) => {
        const ry = py0 + 18 + i * 13;
        ctx.fillStyle = UI[0];
        if (pause.sel === i) ctx.fillText('>', px0 + 4, ry);
        ctx.fillText(row.label, px0 + 10, ry);
        const bx = px0 + 40;
        for (let seg = 0; seg < 10; seg++) {
          const sx2 = bx + seg * 5;
          if (row.on && row.vol > seg * 10) {
            ctx.fillRect(sx2, ry + 1, 4, 6);
          } else {
            ctx.fillRect(sx2, ry + 1, 4, 1);
            ctx.fillRect(sx2, ry + 6, 4, 1);
          }
        }
        if (!row.on) ctx.fillText('OFF', bx + 53, ry);
      });
      const fy = py0 + 18 + 2 * 13;
      ctx.fillStyle = UI[0];
      if (pause.sel === 2) ctx.fillText('>', px0 + 4, fy);
      ctx.fillText('FULLSCREEN', px0 + 10, fy);
      ctx.fillText(isFull() ? 'ON' : 'OFF', px0 + 78, fy);
      const cy = py0 + 18 + 3 * 13;
      ctx.fillStyle = UI[0];
      if (pause.sel === 3) ctx.fillText('>', px0 + 4, cy);
      ctx.fillText('CLOSE', px0 + 10, cy);
    }
  };

  // fixed timestep: game logic always runs at 60 steps/sec regardless of the
  // display's refresh rate (unthrottled rAF ran double speed on 120Hz screens)
  const STEP = 1000 / 60;
  let last = performance.now();
  let acc = 0;
  const loop = (now) => {
    acc += now - last;
    last = now;
    if (acc > 250) acc = 250; // returning from a hidden tab: don't fast-forward
    while (acc >= STEP) {
      tick++;
      pause.t = Math.max(0, Math.min(1, pause.t + (pause.open ? 0.12 : -0.12)));
      if (backpackPulse > 0) backpackPulse--;
      if (bagScene) {
        const s = bagScene;
        s.t++;
        const durs = { in: 14, unzip: 16, fly: FLY_T, zip: 16, out: 14 };
        if (s.t >= durs[s.phase]) {
          s.t = 0;
          if (s.phase === 'in') { s.phase = 'unzip'; blip(988, 0.05, 0.03); }
          else if (s.phase === 'unzip') s.phase = 'fly';
          else if (s.phase === 'fly') { s.phase = 'zip'; blip(740, 0.05, 0.03); }
          else if (s.phase === 'zip') s.phase = 'out';
          else {
            const item = s.item;
            bagScene = null;
            mode = 'play';
            backpackPulse = 12;
            blip(1976, 0.06, 0.04);
            if (collectGot() >= COLLECT_TOTAL) {
              pendingDialog = {
                title: 'BACKPACK FULL!',
                body: 'Every collectable found! A designer is supposed to travel light. This was never going to be that. 100 PERCENT.',
              };
            }
            openDialog(`GOT ${item.name}!`, item.text);
          }
        }
      }
      if (!pause.open) {
        tryMove();
        updatePlayer();
      }
      acc -= STEP;
    }
    render();
    requestAnimationFrame(loop);
  };
  requestAnimationFrame(loop);

  // dev-only introspection for tooling (harmless in production)
  window.__game = {
    get: () => ({ x: player.x, y: player.y, mapId, mode, bag: bagScene ? bagScene.phase : null, got: [...toysGot], jobs: [...jobsRead] }),
    tp: (x, y) => { player.x = x; player.y = y; player.px = x * TILE; player.py = y * TILE; player.moving = false; },
  };

  // ---------- EXPORT MODE: /game?export ----------
  if (location.search.includes('export')) {
    const renderMapCanvas = (id, annotated) => {
      const def = MAPS[id];
      const R = def.rows, w = R[0].length, h = R.length;
      const c = document.createElement('canvas');
      c.width = w * 48; c.height = h * 48;
      const g = c.getContext('2d');
      g.imageSmoothingEnabled = false;
      const interior = R[0][0] === '#';
      const theme = interior ? (def.theme || 'home') : 'outdoor';
      const set = TILE_ART[theme];
      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          const ch = R[y][x];
          const px = x * 48, py = y * 48;
          if (set && TS[set.base.s]) {
            const b = set.base;
            g.drawImage(TS[b.s], b.x * 48, b.y * 48, 48, 48, px, py, 48, 48);
            const art = (def.art && def.art[ch]) || set[ch];
            if (art && art !== set.base && TS[art.s]) {
              g.drawImage(TS[art.s], art.x * 48, art.y * 48, 48, 48, px, py, 48, 48);
            }
          } else {
            g.fillStyle = '#7ba05b'; g.fillRect(px, py, 48, 48);
          }
          if (ch === 'P') { g.fillStyle = '#c9a227'; g.fillRect(px + 12, py + 6, 24, 18); g.fillRect(px + 9, py + 33, 30, 9); }
        }
      }
      if (annotated) {
        g.strokeStyle = 'rgba(255,0,120,0.5)'; g.lineWidth = 1;
        for (let x = 0; x <= w; x++) { g.beginPath(); g.moveTo(x * 48, 0); g.lineTo(x * 48, h * 48); g.stroke(); }
        for (let y = 0; y <= h; y++) { g.beginPath(); g.moveTo(0, y * 48); g.lineTo(w * 48, y * 48); g.stroke(); }
        g.font = 'bold 16px monospace';
        for (let y = 0; y < h; y++) {
          for (let x = 0; x < w; x++) {
            const ch = R[y][x];
            if (SOLID_CHARS.has(ch)) { g.fillStyle = 'rgba(255,0,0,0.18)'; g.fillRect(x * 48, y * 48, 48, 48); }
            if ('DSGgMiP'.includes(ch) && ch !== '.') {
              g.fillStyle = '#fff'; g.fillRect(x * 48 + 2, y * 48 + 2, 18, 20);
              g.fillStyle = '#c00'; g.fillText(ch, x * 48 + 5, y * 48 + 18);
            }
          }
        }
      }
      return c;
    };

    const exPanel = document.createElement('div');
    exPanel.style.cssText = 'position:fixed;inset:0;z-index:99999;background:rgba(7,5,20,.96);color:#f2f0ff;font-family:monospace;overflow:auto;padding:40px';
    exPanel.innerHTML = '<h2 style="margin-bottom:8px">MAP EXPORT</h2><p style="margin-bottom:20px;color:#a8a3cf">Art PNG = painting base (48px/tile). Annotated = grid + logic markers (red = solid, letters = doors/signs/gates/mats/items/trophy — keep these positions functional).<br>Finished paintings go in <b>public/images/game/maps/&lt;mapname&gt;.png</b> at the exact same dimensions.</p>';
    const list = document.createElement('div');
    Object.keys(MAPS).forEach((id) => {
      const def = MAPS[id];
      const row = document.createElement('p');
      row.style.cssText = 'margin:6px 0';
      const dims = `${def.rows[0].length * 48}x${def.rows.length * 48}`;
      row.innerHTML = `<b style="display:inline-block;width:130px">${id}</b> <span style="color:#6b6494">${dims}px</span> `;
      [['art', false], ['annotated', true]].forEach(([label, ann]) => {
        const a = document.createElement('a');
        a.textContent = ` [${label}]`;
        a.href = '#';
        a.style.color = '#ff70ff';
        a.onclick = (e) => {
          e.preventDefault();
          renderMapCanvas(id, ann).toBlob((blob) => {
            const u = URL.createObjectURL(blob);
            const dl = document.createElement('a');
            dl.href = u; dl.download = `${id}${ann ? '-annotated' : ''}.png`;
            dl.click();
            setTimeout(() => URL.revokeObjectURL(u), 5000);
          });
        };
        row.appendChild(a);
      });
      list.appendChild(row);
    });
    exPanel.appendChild(list);
    const ready = () => {
      if (TS.serene && TS.room && TS.fur) document.body.appendChild(exPanel);
      else setTimeout(ready, 200);
    };
    ready();
    // scriptable access for tooling (e.g. saving map PNGs from the console)
    window.__renderMapCanvas = renderMapCanvas;
  }
</script>
