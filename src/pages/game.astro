---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Glenn: The Game | Glenn Cahill" description="A Game Boy RPG through twenty years of design work — twelve offices, one trophy.">
  <section class="gq-page">
    <div class="aurora" aria-hidden="true">
      <div class="blob blob-1"></div>
      <div class="blob blob-3"></div>
    </div>

    <div class="wrap gq-intro">
      <p class="cs-crumb">Bonus level</p>
      <h1 class="cs-title">Glenn: The Game</h1>
      <p class="cs-excerpt">
I have always had a passion for gaming and I wanted to make a playable CV. Enjoy.
</p>
    </div>

    <div class="gameboy">
      <!-- shell art exported from the Figma replica (node 23:207, 2927x1663);
           the live canvas sits in the frame's "Game Canvas" rect and invisible
           hotspots overlay each painted control -->
      <img class="gb-shell-art" src="/images/game/shell/gba-shell.png" alt="" draggable="false" />
      <img class="gb-shell-art gb-shell-portrait" src="/images/game/shell/gb-mobile-portrait.png" alt="" draggable="false" />
      <img class="gb-shell-art gb-shell-landscape" src="/images/game/shell/gb-mobile-landscape.png" alt="" draggable="false" />
      <img class="gb-shell-art gb-shell-page" src="/images/game/shell/gb-mobile-page.png" alt="" draggable="false" />
      <div class="gb-screen-window">
        <canvas id="gq" width="1278" height="864"></canvas>
      </div>
      <button class="gb-hot gb-hot-up" data-dir="up" aria-label="Up"></button>
      <button class="gb-hot gb-hot-down" data-dir="down" aria-label="Down"></button>
      <button class="gb-hot gb-hot-left" data-dir="left" aria-label="Left"></button>
      <button class="gb-hot gb-hot-right" data-dir="right" aria-label="Right"></button>
      <button class="gb-hot" id="gbA" aria-label="A button"></button>
      <button class="gb-hot" id="gbB" aria-label="B button"></button>
      <button class="gb-hot" id="gbStart" aria-label="Settings (Start)"></button>
      <button class="gb-hot" id="gbSelect" aria-label="Fullscreen (Select)"></button>
    </div>
  </section>
</BaseLayout>

<style>
  @font-face {
    font-family: 'Tengoku';
    src: url('/fonts/Tengoku.woff2') format('woff2');
    font-display: swap;
  }

  @font-face {
    font-family: 'Press Start 2P';
    src: url('/fonts/pressstart2p.woff2') format('woff2');
    font-display: swap;
  }

  .gq-page {
    position: relative;
    overflow: hidden;
    padding: calc(var(--nav-h) + clamp(40px, 6vw, 80px)) 0 clamp(70px, 9vw, 120px);
    /* it's a game page: mashing the on-screen controls must never select
       the surrounding copy or flash the mobile tap highlight */
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .gq-page * { -webkit-tap-highlight-color: transparent; }

  .gq-page .aurora { opacity: 0.4; }
  .gq-intro { position: relative; z-index: 2; margin-bottom: clamp(36px, 5vw, 60px); }

  /* the shell: Glenn's Figma replica (node 23:207) as a single exported
     layer, with the live canvas and invisible control hotspots positioned
     by the frame's own geometry (2927x1663) */
  .gameboy {
    position: relative;
    z-index: 2;
    width: min(1300px, calc(100% - 24px));
    margin-inline: auto;
    aspect-ratio: 2927 / 1663;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    filter: drop-shadow(0 40px 90px rgba(0, 0, 0, 0.55));
  }

  .gb-shell-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* the "Game Canvas" rect from the Figma frame: 869.5,326.7 / 1237x837 */
  .gb-screen-window {
    position: absolute;
    left: 29.708%;
    top: 19.643%;
    width: 42.262%;
    height: 50.331%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #gq {
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    background: #10102c;
  }


  /* invisible hotspots over the painted controls */
  .gb-hot {
    position: absolute;
    background: transparent;
    border-radius: 24%;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    cursor: pointer;
  }

  .gb-hot:active { background: rgba(255, 255, 255, 0.09); }

  .gb-hot-up { left: 13.666%; top: 30.407%; width: 4.373%; height: 7.436%; }
  .gb-hot-down { left: 13.666%; top: 45.28%; width: 4.373%; height: 7.436%; }
  .gb-hot-left { left: 9.292%; top: 37.843%; width: 4.373%; height: 7.436%; }
  .gb-hot-right { left: 18.039%; top: 37.843%; width: 4.373%; height: 7.436%; }
  #gbA { left: 84.815%; top: 31.008%; width: 8.926%; height: 15.644%; border-radius: 50%; }
  #gbB { left: 76.957%; top: 36.42%; width: 8.926%; height: 15.644%; border-radius: 50%; }
  #gbStart { left: 12.979%; top: 58.008%; width: 11.333%; height: 11.1%; border-radius: 999px; }
  #gbSelect { left: 12.979%; top: 67.509%; width: 11.333%; height: 11.1%; border-radius: 999px; }

  .gb-hint {
    text-align: center;
    margin-top: 22px;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8f87c6;
  }

  /* ---------- mobile breakpoint: the in-page console is the vertical
     GlennBoy design, fullscreen or not ---------- */
  @media (max-width: 700px) and (orientation: portrait) {
    .gameboy {
      /* gb-mobile-page.png: the portrait shell with 120px spliced out
         between screen and controls, so they sit closer together */
      aspect-ratio: 1626 / 3416;
      width: 100%;
      max-width: none;
      /* crop: trim the forehead above the bezel and below the controls,
         rounded so the device keeps its corners */
      clip-path: inset(12.4% 0 13% 0 round 32px);
      margin-top: -26.1%;
      margin-bottom: -27.3%;
    }
    .gameboy .gb-shell-art { display: none; }
    .gameboy .gb-shell-page { display: block; }
    .gameboy .gb-screen-window { left: 11.931%; top: 19.49%; width: 76.076%; height: 24.5%; }
    .gameboy .gb-hot-up { left: 20.803%; top: 56.94%; width: 9.445%; height: 4.343%; }
    .gameboy .gb-hot-down { left: 20.803%; top: 65.63%; width: 9.445%; height: 4.343%; }
    .gameboy .gb-hot-left { left: 11.358%; top: 61.28%; width: 9.445%; height: 4.343%; }
    .gameboy .gb-hot-right { left: 30.248%; top: 61.28%; width: 9.445%; height: 4.343%; }
    .gameboy #gbA { left: 71.487%; top: 57.42%; width: 18.72%; height: 8.873%; }
    .gameboy #gbB { left: 55.008%; top: 60.49%; width: 18.72%; height: 8.873%; }
    .gameboy #gbStart { left: 30.671%; top: 77.74%; width: 18.184%; height: 3.523%; }
    .gameboy #gbSelect { left: 51.171%; top: 77.74%; width: 18.184%; height: 3.523%; }
  }

  /* ---------- fullscreen mode ---------- */
  .gq-page.gq-full .gq-intro,
  .gq-page.gq-full .gb-hint { display: none; }

  /* opaque backdrop so the page (nav, footer) never shows behind the shell */
  .gq-page.gq-full::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 9998;
    background: #070514;
  }

  /* the mobile shells only exist on touch devices in fullscreen */
  .gb-shell-portrait,
  .gb-shell-landscape,
  .gb-shell-page { display: none; }

  /* mobile portrait fullscreen: swap to the vertical GlennBoy shell (Figma
     node 23:285, 1626x3536) and remap the canvas window + control hotspots
     to that frame's geometry. Desktop and landscape keep the GBA replica. */
  @media (pointer: coarse) and (orientation: portrait) {
    .gq-page.gq-full .gameboy {
      /* NEVER stretch the shell: keep its aspect and fit within the viewport.
         In true fullscreen this fills edge to edge (phone ratios match the
         art within 1%); with browser chrome visible it letterboxes on the
         dark backdrop instead of squashing */
      aspect-ratio: 1626 / 3536;
      width: min(100vw, calc(100dvh * (1626 / 3536)));
      height: auto;
    }
    .gq-page.gq-full .gb-shell-art { display: none; }
    .gq-page.gq-full .gb-shell-portrait { display: block; }
    .gq-page.gq-full .gb-screen-window { left: 11.931%; top: 18.832%; width: 76.076%; height: 23.671%; }
    .gq-page.gq-full .gb-hot-up { left: 20.803%; top: 58.401%; width: 9.445%; height: 4.196%; }
    .gq-page.gq-full .gb-hot-down { left: 20.803%; top: 66.793%; width: 9.445%; height: 4.196%; }
    .gq-page.gq-full .gb-hot-left { left: 11.358%; top: 62.597%; width: 9.445%; height: 4.196%; }
    .gq-page.gq-full .gb-hot-right { left: 30.248%; top: 62.597%; width: 9.445%; height: 4.196%; }
    .gq-page.gq-full #gbA { left: 71.487%; top: 58.864%; width: 18.72%; height: 8.572%; }
    .gq-page.gq-full #gbB { left: 55.008%; top: 61.829%; width: 18.72%; height: 8.572%; }
    .gq-page.gq-full #gbStart { left: 30.671%; top: 78.498%; width: 18.184%; height: 3.404%; }
    .gq-page.gq-full #gbSelect { left: 51.171%; top: 78.498%; width: 18.184%; height: 3.404%; }
  }

  /* mobile landscape fullscreen: the horizontal GlennBoy shell (Figma node
     23:388, 3536x1626) — d-pad left, screen centre, A/B right */
  @media (pointer: coarse) and (orientation: landscape) {
    .gq-page.gq-full .gameboy {
      aspect-ratio: 3536 / 1626;
      width: min(100vw, calc(100dvh * (3536 / 1626)));
      height: auto;
    }
    .gq-page.gq-full .gb-shell-art { display: none; }
    .gq-page.gq-full .gb-shell-landscape { display: block; }
    .gq-page.gq-full .gb-screen-window { left: 30.27%; top: 13.71%; width: 39.889%; height: 58.699%; }
    .gq-page.gq-full .gb-hot-up { left: 12%; top: 23.4%; width: 4.88%; height: 11%; }
    .gq-page.gq-full .gb-hot-down { left: 12%; top: 45.2%; width: 4.88%; height: 11%; }
    .gq-page.gq-full .gb-hot-left { left: 7.32%; top: 34.4%; width: 4.88%; height: 11%; }
    .gq-page.gq-full .gb-hot-right { left: 16.9%; top: 34.4%; width: 4.88%; height: 11%; }
    .gq-page.gq-full #gbA { left: 86.5%; top: 26.5%; width: 9%; height: 20%; }
    .gq-page.gq-full #gbB { left: 77.5%; top: 35.5%; width: 9%; height: 20%; }
    .gq-page.gq-full #gbStart { left: 15.6%; top: 76.5%; width: 9.4%; height: 11.5%; }
    .gq-page.gq-full #gbSelect { left: 75.2%; top: 76.5%; width: 9.4%; height: 11.5%; }
  }

  /* the replica scales to fill the screen, centred; landscape fills the
     height, portrait fills the width */
  .gq-page.gq-full .gameboy {
    position: fixed;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    z-index: 9999;
    clip-path: none;
    margin: 0;
    width: min(100vw, calc(100dvh * (2927 / 1663)));
    max-width: none;
    margin: 0;
    filter: none;
  }
</style>

