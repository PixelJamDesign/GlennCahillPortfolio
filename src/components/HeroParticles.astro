---
// Drifting star particles with cursor repel, for subpage heroes.
// Drop inside any position: relative section — the canvas fills it.
// Same engine as the homepage hero (minus the shooting stars, which stay
// a homepage-only easter egg).
---

<canvas class="hero-particles" data-particles aria-hidden="true"></canvas>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-particles]').forEach((canvas) => {
    const host = canvas.parentElement;
    if (!host || reduceMotion) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const dpr = Math.min(devicePixelRatio || 1, 2);
    const colors = ['133, 112, 255', '255, 112, 255', '242, 240, 255'];
    let W = 0, H = 0;
    let parts: { x: number; y: number; r: number; vy: number; vx: number; c: string; tw: number }[] = [];

    const size = () => {
      W = host.clientWidth;
      H = host.clientHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const seed = () => {
      parts = Array.from({ length: Math.round(W / 22) }, () => ({
        x: Math.random() * W,
        y: Math.random() * H,
        r: 0.6 + Math.random() * 1.6,
        vy: 0.08 + Math.random() * 0.25,
        vx: (Math.random() - 0.5) * 0.08,
        c: colors[(Math.random() * colors.length) | 0],
        tw: Math.random() * Math.PI * 2,
      }));
    };

    size();
    seed();
    addEventListener('resize', () => { size(); seed(); }, { passive: true });

    const GLOW_R = 220;
    let mx = -9999, my = -9999;
    host.addEventListener('pointermove', (e) => {
      const r = host.getBoundingClientRect();
      mx = e.clientX - r.left;
      my = e.clientY - r.top;
    });
    host.addEventListener('pointerleave', () => { mx = my = -9999; });

    const tick = (t: number) => {
      ctx.clearRect(0, 0, W, H);
      for (const p of parts) {
        p.y -= p.vy;
        p.x += p.vx;

        const dx = p.x - mx;
        const dy = p.y - my;
        const d = Math.hypot(dx, dy);
        let boost = 0;
        if (d < GLOW_R && d > 0.001) {
          const f = 1 - d / GLOW_R;
          p.x += (dx / d) * f * 1.6;
          p.y += (dy / d) * f * 1.6;
          boost = f * 0.5;
        }

        if (p.y < -4) { p.y = H + 4; p.x = Math.random() * W; }
        if (p.x < -4) p.x = W + 4;
        if (p.x > W + 4) p.x = -4;

        const a = Math.min(1, 0.18 + 0.4 * (0.5 + 0.5 * Math.sin(t / 900 + p.tw)) + boost);
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r + boost * 1.2, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${p.c}, ${a})`;
        ctx.fill();
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });
</script>
